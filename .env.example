# Server-side only. Never prefix these with VITE_ — they must not reach the browser bundle.
OPENAI_API_KEY=
# Model used for summary assessment (confirm the exact model ID in your OpenAI dashboard).
OPENAI_MODEL=gpt-6-luna

# Fine-grained token scoped to ONE repository with "Contents: Read and write" only.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
# Optional: override for local testing against scripts/fake-github.mjs
# GITHUB_API_URL=http://localhost:4010
# Optional: OPENAI_BASE_URL (default https://api.openai.com/v1), OPENAI_TIMEOUT_MS (default 80000)
